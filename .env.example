# Health Journey: InBody Gemini review + dashboard público.
# Nunca subir credenciales reales al repositorio.
#
# En HF, DATABASE_URL y PUBLIC_DATABASE_URL son SECRETS diferentes.
# El rol público solo puede consultar vistas autorizadas.
# Un Space público sin login solo debe recibir PDFs/JPG previamente anonimizados.
#
# En Neon > Connect > health_journey > main: obtener host y usuario real.
DATABASE_URL=postgresql://ROL_PRIVADO:CONTRASENA@HOST/health_journey?sslmode=require
PUBLIC_DATABASE_URL=postgresql://health_journey_public:CONTRASENA@HOST/health_journey?sslmode=require
# El login HF solo es obligatorio para consultas y escrituras PRIVADAS.
HF_ALLOWED_USERS=jaqo
# Activar únicamente después de validar la cuenta SQL y el acceso OAuth.
ENABLE_PERSISTENCE=0

# Both anonymous demo uploads and consent-only Gemini audit writes use
# ENABLE_ANONYMOUS_DEMO with the restricted DEMO_DATABASE_URL secret below.
# Do not use DATABASE_URL; migration 005 grants EXECUTE on the audit procedure.
# Neither workflow grants private history read permissions.
# Activa las gráficas públicas sin deshabilitar carga y revisión.
ENABLE_PUBLIC_DASHBOARD=1

# Shared feature flag for demo ingestion and consent-only Gemini audit.
# Restricted writer: health_journey_demo_writer, never the private DB role.
# Enable only after configuring DEMO_DATABASE_URL securely in Hugging Face.
ENABLE_ANONYMOUS_DEMO=0
# DEMO_DATABASE_URL=postgresql://health_journey_demo_writer:REPLACE@HOST/health_journey?sslmode=require

# Gemini structured extraction. Configure key as Hugging Face secret, not in Git.
# GEMINI_API_KEY=configure_in_hf_secrets
GEMINI_MODEL=gemini-3.8-flash
# Modelo alternativo una vez tras HTTP 503; usar 'off' para desactivar.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
