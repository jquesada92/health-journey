# Health Journey: InBody Gemini review + dashboard público.
# Nunca subir credenciales reales al repositorio.
#
# Guía completa: docs/hugging-face-variables-y-secrets.md
# En Hugging Face: contraseñas/API keys/URLs van como SECRETS, nunca Variables.
# Las URLs deben apuntar a roles PostgreSQL distintos y con TLS.
# Un Space público sin login solo debe recibir PDFs/JPG previamente anonimizados.
#
# En Neon > Connect > health_journey > main: obtener host y usuario real.
# Secret: conexión privada para historial (requiere ENABLE_PERSISTENCE y OAuth).
DATABASE_URL=postgresql://ROL_PRIVADO:CONTRASENA@HOST/health_journey?sslmode=require
# Secret: lector de vistas publicadas; sin acceso a IDs ni auditorías privadas.
PUBLIC_DATABASE_URL=postgresql://health_journey_public:CONTRASENA@HOST/health_journey?sslmode=require
# Variable: usuarios OAuth de Hugging Face autorizados para historial privado;
# separar varios usernames con comas, sin introducir IDs del InBody.
HF_ALLOWED_USERS=jaqo
# Secret: optional authorized private lookup alias. The word "test" in
# the Dashboard search resolves to this person's ID ONLY after HF OAuth.
# Set the actual InBody identifier in the Space's Secrets (never in Git).
# DASHBOARD_TEST_PERSON_ID=REPLACE_PRIVATELY
# Variable: habilita el flujo privado heredado con DATABASE_URL/OAuth.
# No controla el guardado consentido de Gemini con DEMO_DATABASE_URL.
ENABLE_PERSISTENCE=0
# Optional full-app Gradio login. When enabled, the whole Space requires
# the existing Neon application account obs-master-demo and its password.
# Password verifier lives ONLY in private Neon table hj_app_accounts.
# No plaintext password / password hash is committed to this repository.
# Uses DATABASE_URL and SQL migration 006; does not use DEMO_DATABASE_URL.
ENABLE_APP_PASSWORD_LOGIN=0


# Both anonymous demo uploads and consent-only Gemini audit writes use
# ENABLE_ANONYMOUS_DEMO with the restricted DEMO_DATABASE_URL secret below.
# Do not use DATABASE_URL; migration 005 grants EXECUTE on the audit procedure.
# Neither workflow grants private history read permissions.
# Variable: permite consultar SOLO vistas aprobadas usando PUBLIC_DATABASE_URL.
# No publica automáticamente las auditorías Gemini almacenadas.
ENABLE_PUBLIC_DASHBOARD=1

# Variable: habilita demo sin login + auditorías Gemini consentidas.
# Requiere DEMO_DATABASE_URL y funciones SQL 004/005. NO habilita lectura privada.
# En modo demo el UI actual desactiva los controles de consulta privada.
ENABLE_ANONYMOUS_DEMO=0
# Secret: usuario health_journey_demo_writer, solo EXECUTE de funciones
# controladas. Sin permisos directos a tablas privadas. Nunca admin.
# DEMO_DATABASE_URL=postgresql://health_journey_demo_writer:REPLACE@HOST/health_journey?sslmode=require

# Secret: Gemini API key de Google AI Studio; NO publicar su valor.
# GEMINI_API_KEY=configure_in_hf_secrets
# Variable: modelo principal disponible para la clave configurada.
# Un modelo no autorizado puede producir HTTP 404.
GEMINI_MODEL=gemini-3.8-flash
# Modelo alternativo una vez tras HTTP 503; usar 'off' para desactivar.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
