# Copy to .env locally. NEVER commit .env or actual credentials.
# In Neon console: health-journey > Connect > health_journey > main
DATABASE_URL=postgresql://USER:PASSWORD@HOST/health_journey?sslmode=require
# Enable manual saves ONLY when running the app locally on 127.0.0.1.
ENABLE_PERSISTENCE=0
# OFF until public consent, database migration and disclosure review are complete.
ENABLE_PUBLIC_DASHBOARD=0
# Only for a SEPARATE, read-only public Space. Never use the private DATABASE_URL.
# Configure health_journey_public as a login role with limited SELECT on its view.
# PUBLIC_DATABASE_URL=postgresql://health_journey_public:REPLACE@HOST/health_journey?sslmode=require
